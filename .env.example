# O banco SQLite e as fotos ficam em DATA_DIR. Preserve essa pasta na hospedagem.
DATA_DIR=./data
# Defina uma chave aleatória com pelo menos 32 caracteres na hospedagem.
SECRET_KEY=
# true na hospedagem HTTPS; false para testar por HTTP no computador.
COOKIE_SECURE=false
# Usados apenas na primeira inicialização, quando não existe administrador.
ADMIN_USERNAME=
ADMIN_PASSWORD=
